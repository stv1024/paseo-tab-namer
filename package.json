{
  "name": "paseo-tab-namer",
  "private": true,
  "version": "0.1.0",
  "description": "Paseo plugin: rename a workspace from what its Tabs are about, using a model from a provider already enabled in Paseo.",
  "author": "stv1024",
  "license": "MIT",
  "homepage": "https://github.com/stv1024/paseo-tab-namer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stv1024/paseo-tab-namer.git"
  },
  "bugs": {
    "url": "https://github.com/stv1024/paseo-tab-namer/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "workspace",
    "rename"
  ],
  "files": [
    "paseo-plugin.json",
    "LICENSE",
    "OVERVIEW.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "OVERVIEW.*.md",
    "docs/images/popover.png",
    "docs/images/settings.png",
    "!**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "pack:npm": "node scripts/pack-npm.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@getpaseo/client": "^0.11.2",
    "@getpaseo/plugin": "0.11.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
